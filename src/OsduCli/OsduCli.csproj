<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>osducs</AssemblyName>
    <Version>0.7.3</Version>
    <RootNamespace>Equinor.OsduCli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OsduCli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11"/>
    <PackageReference Include="System.CommandLine" Version="2.0.11"/>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11"/>
  </ItemGroup>

  <!-- The client is consumed as a package, not a sibling checkout, so this repo builds on
       its own. Do not go below 2.0.0: it carries the three fixes this CLI depends on — an
       encrypted MSAL token cache (#98), a content type on bodiless requests (#101, without
       which Storage's query endpoints answer 415), and untyped string responses (#103,
       without which `record get` prints nothing).

       2.0.0 made the core package authentication-agnostic: it no longer bundles MSAL, and
       `OsduClient` no longer defaults to interactive sign-in. The MSAL providers now live in
       a separate optional package, which a CLI for humans at a terminal plainly needs. The
       two version numbers move in lockstep upstream, so keep them equal here.

       2.1.0 adds the `Username` property that account selection needs, so a token cache
       holding more than one account stops being resolved by whichever one MSAL returns
       first.

       2.2.0 moved the MSAL providers into a namespace matching their package, so that which
       package a type comes from is visible at the using rather than hidden.

       2.2.1 untypes spec properties declared as strings but exemplified as JSON objects.
       Without it `schema add` silently dropped the caller's schema and the service rejected
       the request for a field that had been supplied. -->
  <ItemGroup>
    <PackageReference Include="Equinor.OsduCsharpClient" Version="2.2.1"/>
    <PackageReference Include="Equinor.OsduCsharpClient.Msal" Version="2.2.1"/>
  </ItemGroup>

</Project>
