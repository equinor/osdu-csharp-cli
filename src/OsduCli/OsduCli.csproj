<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>osducs</AssemblyName>
    <Version>0.4.0</Version>
    <RootNamespace>Equinor.OsduCli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OsduCli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.11"/>
    <PackageReference Include="System.CommandLine" Version="2.0.11"/>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11"/>
  </ItemGroup>

  <!-- The client is consumed as a package, not a sibling checkout, so this repo builds on
       its own. 1.1.9 is the first release with all three client fixes this CLI depends on:
       an encrypted MSAL token cache (#98), a content type on bodiless requests (#101,
       without which Storage's query endpoints answer 415), and untyped string responses
       (#103, without which `record get` prints nothing). Do not go below it. -->
  <ItemGroup>
    <PackageReference Include="Equinor.OsduCsharpClient" Version="1.1.9"/>
  </ItemGroup>

</Project>
