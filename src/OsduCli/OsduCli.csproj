<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>osducs</AssemblyName>
    <Version>0.2.1</Version>
    <RootNamespace>Equinor.OsduCli</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>OsduCli.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.11"/>
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.11"/>
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.11"/>
  </ItemGroup>

  <!-- The client is consumed as a package, not a sibling checkout, so this repo builds on
       its own. NOTE: 1.1.6 still writes an unencrypted MSAL token cache; equinor/osdu-csharp-client#98
       fixes that and releases 1.1.7. Bump to 1.1.7 before distributing any binary. -->
  <ItemGroup>
    <PackageReference Include="Equinor.OsduCsharpClient" Version="1.1.6"/>
  </ItemGroup>

</Project>
